network:
  version: 2
  ethernets:
    # Management keeps its DHCP address but installs no routes: a default
    # route here would compete with the one the routers learn.
    ens3:
      dhcp4: true
      dhcp4-overrides:
        use-routes: false
{% for link in links %}
    {{ link.name }}:
      match:
        macaddress: "{{ link.mac }}"
      set-name: {{ link.name }}
      addresses: [{{ link.ip }}]
{% endfor %}
